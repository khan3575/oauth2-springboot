# Copy to .env and fill in real values before running `docker compose up`.
# .env is gitignored — never commit real credentials.

# Postgres
DB_NAME=oauth2springboot
DB_USERNAME=oauth2user
DB_PASSWORD=change-me

# App
APP_BASE_URL=http://localhost:8080
APP_PORT=8080
# Comma-separated origins allowed to call /api/** cross-origin, e.g. a local frontend dev server.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mail — required even for local docker-compose use; registration/password-reset
# emails fail without a real SMTP account (any provider, or a local catch-all like Mailtrap).
MAIL_FROM=noreply@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
